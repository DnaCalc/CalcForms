target/
*.tmp
*.log
.env
.env.*

# Local Cargo overrides may point at sibling checkouts such as ../OxVba during
# coordinated development. Keep those machine-specific paths out of shared state.
/.cargo/config
/.cargo/config.toml

# bv (beads viewer) local config and caches
.bv/

# Local lock and migration files produced by current br.
.beads/*.db-*
.beads/*.db.fsqlite-*
.beads/.beads.vacuum.*
.beads/.br_recovery/

# Capture staging leftovers (canonical capture is the non-dot directory)
**/.W010*.capture-staging-*/
**/.designer-band-*.capture-staging-*/
