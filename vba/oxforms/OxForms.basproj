<Project Sdk="OxVba.Sdk/0.1.0">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <ProjectName>OxForms</ProjectName>
  </PropertyGroup>
  <ItemGroup Label="Object model">
    <Module Include="OxFormsModel.bas" />
    <ClassModule Include="IOxControl.cls" />
    <ClassModule Include="IOxControlHost.cls" />
    <ClassModule Include="OxControlCore.cls" />
    <ClassModule Include="OxReturnInteger.cls" />
    <ClassModule Include="OxReturnBoolean.cls" />
    <ClassModule Include="Label.cls" />
    <ClassModule Include="TextBox.cls" />
    <ClassModule Include="CommandButton.cls" />
    <ClassModule Include="OxUserForm.cls" />
  </ItemGroup>
  <ItemGroup Label="Rendering (Scene self-render)">
    <Module Include="OxTheme.bas" />
    <Module Include="OxControlPaint.bas" />
    <ClassModule Include="OxSceneBuilder.cls" />
  </ItemGroup>
  <ItemGroup Label="W002 smoke (render path; retired when the runtime backend lands)">
    <Module Include="OxForms.bas" />
    <ClassModule Include="OxFormsSmokeForm.cls" />
  </ItemGroup>
</Project>
