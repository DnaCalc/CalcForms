<Project Sdk="CalcVBA.Sdk/0.1.0">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <ProjectName>CalcForms</ProjectName>
  </PropertyGroup>
  <ItemGroup Label="Object model">
    <Module Include="CalcFormsModel.bas" />
    <ClassModule Include="IOxControl.cls" />
    <ClassModule Include="IOxControlHost.cls" />
    <ClassModule Include="IOxControlContainer.cls" />
    <ClassModule Include="OxControlCore.cls" />
    <ClassModule Include="Controls.cls" />
    <ClassModule Include="ReturnInteger.cls" />
    <ClassModule Include="ReturnBoolean.cls" />
    <ClassModule Include="Font.cls" />
    <ClassModule Include="Label.cls" />
    <ClassModule Include="OxTextService.cls" />
    <ClassModule Include="TextBox.cls" />
    <ClassModule Include="CommandButton.cls" />
    <ClassModule Include="CheckBox.cls" />
    <ClassModule Include="ListBox.cls" />
    <ClassModule Include="ComboBox.cls" />
    <ClassModule Include="Frame.cls" />
    <ClassModule Include="Image.cls" />
    <ClassModule Include="MultiPage.cls" />
    <ClassModule Include="Page.cls" />
    <ClassModule Include="Pages.cls" />
    <ClassModule Include="SpinButton.cls" />
    <ClassModule Include="ScrollBar.cls" />
    <ClassModule Include="Tab.cls" />
    <ClassModule Include="Tabs.cls" />
    <ClassModule Include="TabStrip.cls" />
    <ClassModule Include="ToggleButton.cls" />
    <ClassModule Include="OptionButtonControl.cls" />
    <ClassModule Include="UserForm.cls" />
    <ClassModule Include="OxAccessibilityService.cls" />
    <ClassModule Include="OxFrmMaterializer.cls" />
    <ClassModule Include="OxInteractionManager.cls" />
    <ClassModule Include="OxReducer.cls" />
  </ItemGroup>
  <ItemGroup Label="Rendering (Scene self-render)">
    <Module Include="OxTheme.bas" />
    <Module Include="OxControlPaint.bas" />
    <ClassModule Include="OxSceneBuilder.cls" />
  </ItemGroup>
  <ItemGroup Label="W002 smoke (render path; retired when the runtime backend lands)">
    <Module Include="CalcForms.bas" />
    <ClassModule Include="CalcFormsSmokeForm.cls" />
  </ItemGroup>
</Project>
