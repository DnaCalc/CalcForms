  "automationScript": [
    "Generate a workbook containing the outer and inner UserForms from this manifest.",
    "Show the outer form modeless with ShowW006NestedOuterModeless.",
    "Click the outer Inner Hide button so the outer button Click handler calls the inner form with Show vbModal; click the inner Hide button and record the modal return.",
    "Click the outer Inner Unload button so the outer button Click handler calls the inner form with Show vbModal; click the inner Unload button and record QueryClose/Terminate rows if raised.",
    "Click the outer Inner Alt+F4 button so the outer button Click handler calls the inner form with Show vbModal; drive Alt+F4 against the inner modal window and record QueryClose/Terminate rows if raised.",
    "Click the outer Hide button, reshow the outer form modeless, then click the outer Unload button.",
    "Preserve workbook, worksheet export, command logs, screenshots/window manifests, input actions, run summary, manifest, and hashes under W006 evidence."
  ],
  "notes": {
    "scope": "This fixture builds repo-owned Excel/MSForms oracle inputs only. It does not implement OxForms behavior and does not settle final MSForms ordering by itself.",
    "nestedModal": "The inner form is entered from an outer CommandButton Click handler using Show vbModal. The VBA row before that call is used as the parent_row_id for inner rows.",
    "rows": "Rows emitted by fixture action logging such as BeforeHide or BeforeUnload are explicit fixture observations. They are not MSForms event names unless the event_name is a public MSForms event such as QueryClose or Terminate.",
    "missingRows": "Missing rows are not negative MSForms facts. Live output from oxforms-0a0.19 remains the oracle evidence."
  }
